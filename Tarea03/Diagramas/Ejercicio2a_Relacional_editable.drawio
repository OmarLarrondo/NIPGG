        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    MUSEO {\n        int IdMuseo PK\n        string Nombre\n        string Telefono\n        string Calle\n        string Numero\n        string CP\n        string Estado\n    }\n\n    COLECCION {\n        int IdColeccion PK\n        string Nombre\n        string Descripcion\n        string Tipo\n        string Contacto\n        string Telefono\n    }\n\n    ARTISTA {\n        int IdArtista PK\n        string Nombre\n        string Paterno\n        string Materno\n        date Nacimiento\n        date Defuncion\n        string Pais\n        string Epoca\n        string Estilo\n        string Descripcion\n    }\n\n    EXHIBICION {\n        int IdExhibicion PK\n        string Titulo\n    }\n\n    OBRA {\n        int IdObra PK\n        string Titulo\n        string Descripcion\n        string Tipo\n        int IdMuseo FK\n        int IdColeccion FK\n        int IdArtista FK\n    }\n\n    OBRA_MATERIAL {\n        int IdObra PK,FK\n        string Material PK\n    }\n\n    PERMANENTE {\n        int IdObra PK,FK\n        date Fecha_Adq\n        decimal Costo\n    }\n\n    PRESTADA {\n        int IdObra PK,FK\n        string Prestador\n        date Fecha_Pres\n        date Fecha_Dev\n    }\n\n    PINTURA {\n        int IdObra PK,FK\n        string Tecnica\n        string Estilo\n        string Genero\n    }\n\n    ESCULTURA {\n        int IdObra PK,FK\n        string Estilo\n        string Dimensiones\n        decimal Peso\n    }\n\n    MISCELANEA {\n        int IdObra PK,FK\n        string Formato\n        string Pais\n    }\n\n    EXHIBIR {\n        int IdObra PK,FK\n        int IdExhibicion PK,FK\n        date Fecha_Inicio PK\n        date Fecha_Fin\n    }\n\n    INTERACTUAR {\n        int IdColeccion PK,FK\n        int IdMuseo PK,FK\n    }\n\n    %% Relaciones principales\n    MUSEO ||--o{ OBRA : \&quot;Posee\&quot;\n    COLECCION ||--o{ OBRA : \&quot;Tiene\&quot;\n    ARTISTA ||--o{ OBRA : \&quot;Crea\&quot;\n    MUSEO ||--o{ INTERACTUAR : \&quot;interactua\&quot;\n    COLECCION ||--o{ INTERACTUAR : \&quot;interactua\&quot;\n\n    %% Atributo multivaluado\n    OBRA ||--o{ OBRA_MATERIAL : \&quot;tiene_material\&quot;\n\n    %% Jerarquia por condicion de tenencia (disjunta)\n    OBRA ||--o| PERMANENTE : \&quot;es\&quot;\n    OBRA ||--o| PRESTADA : \&quot;es\&quot;\n\n    %% Jerarquia por tipo de obra (disjunta)\n    OBRA ||--o| PINTURA : \&quot;es\&quot;\n    OBRA ||--o| ESCULTURA : \&quot;es\&quot;\n    OBRA ||--o| MISCELANEA : \&quot;es\&quot;\n\n    %% Relacion N:M\n    OBRA ||--o{ EXHIBIR : \&quot;se_exhibe\&quot;\n    EXHIBICION ||--o{ EXHIBIR : \&quot;contiene\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sp_3R3NUl3PiaHFrNQNm-1">
